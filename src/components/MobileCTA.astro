---
// Sticky bottom bar on mobile: quick call + booking.
import { site } from '../config/site';
import { url } from '../utils/url';
import Icon from './Icon.astro';
---

<div class="mobile-cta">
  <a href={`tel:${site.contact.phoneHref}`} class="btn btn--ghost"><Icon name="phone" />Zadzwoń</a>
  <a href={url('/rezerwacja')} class="btn"><Icon name="calendar" />Zarezerwuj</a>
</div>

<style>
  .mobile-cta { display: none; }
  @media (max-width: 860px) {
    .mobile-cta {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      position: fixed;
      inset: auto 0 0 0;
      z-index: 40;
      padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
      background: color-mix(in srgb, var(--bg) 94%, transparent);
      backdrop-filter: blur(8px);
      border-top: 1px solid var(--line);
    }
    .mobile-cta .btn { padding: 12px; }
  }
</style>
