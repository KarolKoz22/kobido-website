---
import { site } from '../config/site';
import { url } from '../utils/url';
interface Props { title?: string; text?: string; alt?: boolean }
const {
  alt = true,
  title = 'Podaruj sobie chwilę dla siebie',
  text = 'Wybierz dogodny termin online lub zadzwoń — chętnie odpowiem na pytania.',
} = Astro.props;
---

<section class:list={['section', alt ? 'section--alt' : 'cta--bordered']}>
  <div class="container center narrow">
    <h2>{title}</h2>
    <p class="muted">{text}</p>
    <div class="btn-row">
      <a href={url('/rezerwacja')} class="btn">Zarezerwuj termin</a>
      <a href={`tel:${site.contact.phoneHref}`} class="btn btn--ghost">{site.contact.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta--bordered { border-top: 1px solid var(--line); }
</style>
