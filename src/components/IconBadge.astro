---
/**
 * Line icon in a soft round tile with a thin halo ring.
 * Comes alive when its parent link or `.hover-group` is hovered/focused:
 * phone rings, envelope flap opens, pin bounces, clock hand turns, calendar ticks,
 * chat dots pulse — every other icon breathes gently.
 */
import { icons, type IconName } from '../utils/icons';

interface Props {
  name: IconName;
  size?: 'sm' | 'md' | 'lg';
  solid?: boolean;
}
const { name, size = 'md', solid = false } = Astro.props;
const special = ['phone', 'mail', 'pin', 'clock', 'calendar-check', 'chat'];
const anim = special.includes(name) ? name : 'breathe';
---

<span class:list={['ib', `ib--${size}`, { 'ib--solid': solid }]} data-anim={anim} aria-hidden="true">
  <svg viewBox="0 0 24 24" set:html={icons[name]} />
</span>

<style>
  .ib {
    position: relative;
    display: inline-grid;
    place-items: center;
    flex: none;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    transition: transform 0.3s ease, background 0.3s ease, color 0.3s ease;
  }
  /* thin halo ring, slightly offset — grows on hover */
  .ib::before {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
    transition: transform 0.4s ease, opacity 0.4s ease;
  }
  .ib--solid { background: var(--btn-bg); color: var(--on-accent); }
  .ib--sm { width: 38px; height: 38px; }
  .ib--sm::before { inset: -3px; }
  .ib--md { width: 56px; height: 56px; }
  .ib--lg { width: 76px; height: 76px; }

  .ib svg {
    width: 50%;
    height: 50%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }
  .ib--sm svg { width: 48%; height: 48%; stroke-width: 1.6; }

  .ib :global(.ib__waves) { opacity: 0.5; transition: opacity 0.2s; }
  .ib :global(.ib__flap) { transform-origin: 12px 6px; transition: transform 0.3s ease; }
  .ib :global(.ib__hand) { transform-origin: 12px 12px; transition: transform 0.6s ease; }
  .ib :global(.ib__tick) { stroke-dasharray: 10; stroke-dashoffset: 0; }
  .ib :global(.ib__dot) { stroke-width: 2.4; }
  .ib :global(.ib__twinkle) { transform-origin: 19px 4.5px; transition: transform 0.4s ease, opacity 0.4s; }

  /* ---- hover / focus of the parent link or card ---- */
  :global(:is(a, .hover-group):is(:hover, :focus-visible)) .ib { transform: translateY(-2px); }
  :global(:is(a, .hover-group):is(:hover, :focus-visible)) .ib:not(.ib--solid) { background: color-mix(in srgb, var(--accent) 22%, var(--surface)); }
  :global(:is(a, .hover-group):is(:hover, :focus-visible)) .ib::before { transform: scale(1.12); opacity: 0.4; }

  :global(:is(a, .hover-group):is(:hover, :focus-visible)) .ib[data-anim='phone'] svg { animation: ib-ring 0.8s ease-in-out; }
  :global(:is(a, .hover-group):is(:hover, :focus-visible)) .ib[data-anim='phone'] :global(.ib__waves) { opacity: 1; animation: ib-waves 0.8s ease-in-out infinite alternate; }
  :global(:is(a, .hover-group):is(:hover, :focus-visible)) .ib[data-anim='mail'] :global(.ib__flap) { transform: scaleY(-1) translateY(-1px); }
  :global(:is(a, .hover-group):is(:hover, :focus-visible)) .ib[data-anim='pin'] svg { animation: ib-bounce 0.7s ease; }
  :global(:is(a, .hover-group):is(:hover, :focus-visible)) .ib[data-anim='clock'] :global(.ib__hand) { transform: rotate(360deg); }
  :global(:is(a, .hover-group):is(:hover, :focus-visible)) .ib[data-anim='calendar-check'] :global(.ib__tick) { animation: ib-draw 0.6s ease; }
  :global(:is(a, .hover-group):is(:hover, :focus-visible)) .ib[data-anim='chat'] :global(.ib__dot) { animation: ib-dot 0.9s ease-in-out infinite; }
  :global(:is(a, .hover-group):is(:hover, :focus-visible)) .ib[data-anim='chat'] :global(.ib__dot:nth-of-type(3)) { animation-delay: 0.15s; }
  :global(:is(a, .hover-group):is(:hover, :focus-visible)) .ib[data-anim='chat'] :global(.ib__dot:nth-of-type(4)) { animation-delay: 0.3s; }
  :global(:is(a, .hover-group):is(:hover, :focus-visible)) .ib[data-anim='breathe'] svg { animation: ib-breathe 1.2s ease-in-out; }
  :global(:is(a, .hover-group):is(:hover, :focus-visible)) .ib :global(.ib__twinkle) { transform: rotate(90deg) scale(1.3); }

  @keyframes ib-ring {
    0%, 100% { transform: rotate(0); }
    15%, 45%, 75% { transform: rotate(-14deg); }
    30%, 60%, 90% { transform: rotate(14deg); }
  }
  @keyframes ib-waves { from { opacity: 0.35; } to { opacity: 1; } }
  @keyframes ib-dot {
    0%, 100% { opacity: 1; transform: translateY(0); }
    50% { opacity: 0.4; transform: translateY(-1.5px); }
  }
  @keyframes ib-bounce {
    0%, 100% { transform: translateY(0); }
    40% { transform: translateY(-4px); }
    70% { transform: translateY(1px); }
  }
  @keyframes ib-draw { from { stroke-dashoffset: 10; } to { stroke-dashoffset: 0; } }
  @keyframes ib-breathe {
    0%, 100% { transform: scale(1) rotate(0); }
    50% { transform: scale(1.12) rotate(-6deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ib svg, .ib :global(*) { animation: none !important; }
  }
</style>
