---
/**
 * Google Calendar Appointment Schedule embed.
 * Bookings made here land directly in the owner's Google Calendar and
 * the client gets an email confirmation from Google. No backend required.
 * Set `bookingUrl` in src/config/site.ts — see CLAUDE.md for setup.
 */
import { site } from '../config/site';
const hasBooking = site.bookingUrl.length > 0;
---

{hasBooking ? (
  <div class="booking">
    <iframe
      src={site.bookingUrl}
      title="Kalendarz rezerwacji"
      loading="lazy"
      frameborder="0"
    ></iframe>
  </div>
) : (
  <div class="booking booking--empty card">
    <span class="eyebrow">Wkrótce</span>
    <h3>Tutaj pojawi się kalendarz rezerwacji</h3>
    <p class="muted">
      Kalendarz połączony z Google Calendar — wolne terminy będą widoczne na żywo,
      a każda rezerwacja automatycznie trafi do kalendarza.
    </p>
    <p>Do tego czasu zapraszam do rezerwacji telefonicznej:</p>
    <a href={`tel:${site.contact.phoneHref}`} class="btn">{site.contact.phone}</a>
  </div>
)}

<style>
  .booking { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .booking iframe { display: block; width: 100%; height: 760px; border: 0; }
  .booking--empty { text-align: center; padding: clamp(40px, 8vw, 80px) 24px; }
  .booking--empty p { max-width: 520px; margin-inline: auto; }
</style>
