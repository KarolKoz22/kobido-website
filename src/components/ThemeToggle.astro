---
// Light/dark switch. Follows the OS preference until the visitor picks a theme; the choice is saved
// in localStorage and applied before first paint by the inline script in BaseLayout.
import Icon from './Icon.astro';
---

<button type="button" class="theme-toggle" aria-label="Przełącz tryb jasny / ciemny" title="Tryb jasny / ciemny">
  <Icon name="moon" class="theme-toggle__moon" />
  <Icon name="sun" class="theme-toggle__sun" />
</button>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    flex: none;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .theme-toggle:hover { color: var(--accent); border-color: var(--accent); background: var(--accent-soft); }
  .theme-toggle :global(.icon) {
    grid-area: 1 / 1;
    width: 19px;
    height: 19px;
    vertical-align: 0;
    transition: transform 0.35s ease, opacity 0.35s ease;
  }
  .theme-toggle :global(.theme-toggle__sun) { opacity: 0; transform: rotate(-90deg) scale(0.6); }

  /* Moon while light (click → dark), sun while dark (click → light). */
  :global(:root[data-theme='dark']) .theme-toggle :global(.theme-toggle__sun) { opacity: 1; transform: none; }
  :global(:root[data-theme='dark']) .theme-toggle :global(.theme-toggle__moon) { opacity: 0; transform: rotate(90deg) scale(0.6); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle :global(.theme-toggle__sun) { opacity: 1; transform: none; }
    :global(:root:not([data-theme='light'])) .theme-toggle :global(.theme-toggle__moon) { opacity: 0; transform: rotate(90deg) scale(0.6); }
  }
</style>

<script>
  type Theme = 'light' | 'dark';
  declare global {
    interface Window {
      applyTheme?: (theme?: Theme | null) => void; // defined by the inline bootstrap in BaseLayout
    }
  }

  const root = document.documentElement;
  const media = matchMedia('(prefers-color-scheme: dark)');
  const current = (): Theme => (root.dataset.theme as Theme | undefined) ?? (media.matches ? 'dark' : 'light');

  document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((button) => {
    button.addEventListener('click', () => {
      const next: Theme = current() === 'dark' ? 'light' : 'dark';
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Storage blocked (private mode) — the choice still applies to this page.
      }
      window.applyTheme?.(next);
    });
  });
</script>
