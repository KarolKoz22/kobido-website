---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BookingEmbed from '../components/BookingEmbed.astro';
import { site } from '../config/site';

const info = [
  { title: 'Przed wizytą', text: 'Przyjdź najlepiej bez makijażu. Zarezerwuj ok. 10 minut na krótki wywiad.' },
  { title: 'Odwołanie wizyty', text: 'Prosimy o odwołanie wizyty najpóźniej 24 h wcześniej — link znajdziesz w mailu z potwierdzeniem.' },
  { title: 'Przeciwwskazania', text: 'M.in. stany zapalne skóry, świeże zabiegi medycyny estetycznej, gorączka. W razie wątpliwości — zadzwoń.' },
];
---

<BaseLayout title="Rezerwacja" description="Zarezerwuj masaż Kobido online — wybierz dogodny termin.">
  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Rezerwacja" title="Wybierz dogodny termin">
        <p>
          Zaznacz wolny termin w kalendarzu — potwierdzenie otrzymasz mailem.
          Wolisz porozmawiać? Zadzwoń: <a href={`tel:${site.contact.phoneHref}`}>{site.contact.phone}</a>
        </p>
      </SectionHeading>

      <div class="narrow-wide">
        <BookingEmbed />
      </div>

      <div class="grid grid--3 info">
        {info.map((i) => (
          <div>
            <h3>{i.title}</h3>
            <p class="muted">{i.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow-wide { max-width: 900px; margin-inline: auto; }
  .info { margin-top: 72px; }
  .info > div { border-top: 1px solid var(--line); padding-top: 24px; }
  .info h3 { font-size: 1.3rem; }
</style>
