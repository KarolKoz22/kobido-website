---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import CtaBand from '../components/CtaBand.astro';
import MotifMarquee from '../components/MotifMarquee.astro';
import { site, certificates } from '../config/site';
import { url } from '../utils/url';

const values = [
  { title: 'Indywidualne podejście', text: 'Każdy zabieg dopasowuję do potrzeb i kondycji Twojej skóry.' },
  { title: 'Spokój i uważność', text: 'Bez pośpiechu. Godzina, w której liczysz się tylko Ty.' },
  { title: 'Pasja, nie rutyna', text: 'Robię to, co kocham — i wierzę, że czujesz to w każdym ruchu dłoni.' },
];
---

<BaseLayout title="O mnie" description={`Poznaj ${site.owner} — certyfikowaną terapeutkę masażu Kobido.`}>
  <!-- INTRO -->
  <section class="section">
    <div class="container grid grid--2">
      <ImagePlaceholder src={site.ownerPhoto} alt={site.owner} ratio="4 / 5" position="50% 30%" />
      <div>
        <span class="eyebrow">O mnie</span>
        <h1>{site.owner}</h1>
        <p class="lead">Certyfikowana terapeutka masażu Kobido</p>
        <p class="muted">
          Od zawsze wierzyłam, że dbanie o siebie to nie luksus, tylko codzienny gest czułości
          wobec samej siebie. Pielęgnacja, chwila ciszy, dobry masaż — to były moje małe rytuały,
          zanim jeszcze wiedziałam, że zamienię je w swoją drogę.
        </p>
        <p class="muted">
          Moją wielką fascynacją stała się Japonia — jej filozofia równowagi, szacunek do ciała
          i przekonanie, że piękno płynie z harmonii, a nie z pośpiechu. Kiedy poznałam Kobido,
          nazywane „cesarskim masażem twarzy”, poczułam, że to właśnie to: technika, w której
          tradycja spotyka się z naturalnym liftingiem, a relaks z widocznym efektem.
        </p>
        <p class="muted">
          Dziś w moim gabinecie w Sosnowcu dzielę się tym rytuałem z Tobą. Każda wizyta to godzina,
          w której nic nie musisz — wystarczy, że się położysz, odetchniesz i pozwolisz sobie
          na chwilę tylko dla siebie.
        </p>
        <p class="quote">„Piękno zaczyna się w chwili, gdy zaczynasz o siebie dbać.”</p>
      </div>
    </div>
  </section>

  <!-- MOTYWY (animowany pasek) -->
  <MotifMarquee />

  <!-- WARTOŚCI -->
  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Jak pracuję" title="Co jest dla mnie ważne" />
      <div class="grid grid--3">
        {values.map((v) => (
          <div class="value">
            <h3>{v.title}</h3>
            <p class="muted">{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CERTYFIKATY -->
  <section class="section section--alt" id="certyfikaty">
    <div class="container">
      <SectionHeading eyebrow="Kwalifikacje" title="Certyfikaty i szkolenia">
        <p>Ukończone kursy i szkolenia potwierdzające moje kwalifikacje.</p>
      </SectionHeading>
      <div class="certs">
        {certificates.map((c) => (
          <article class="cert">
            {c.image ? (
              <img src={url(c.image)} alt={`Certyfikat: ${c.title}`} loading="lazy" />
            ) : (
              <ImagePlaceholder label="Skan certyfikatu" ratio="4 / 3" />
            )}
            <div class="cert__body">
              {c.year && <span class="cert__year">{c.year}</span>}
              <h3>{c.title}</h3>
              {c.issuer && <p class="muted">{c.issuer}</p>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- GABINET -->
  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Gabinet" title="Tu się spotkamy">
        <p>{site.contact.address}</p>
      </SectionHeading>
      <div class="gallery">
        <ImagePlaceholder label="Gabinet — zdjęcie 1" ratio="1 / 1" />
        <ImagePlaceholder label="Gabinet — zdjęcie 2" ratio="1 / 1" />
        <ImagePlaceholder label="Gabinet — zdjęcie 3" ratio="1 / 1" />
      </div>
    </div>
  </section>

  <CtaBand title="Zapraszam na wizytę" />
</BaseLayout>

<style>
  .lead { font-family: var(--font-serif); font-size: 1.5rem; font-style: italic; color: var(--accent); margin-bottom: 1.4em; }

  .quote {
    font-family: var(--font-serif); font-size: 1.4rem; font-style: italic; color: var(--text);
    border-left: 2px solid var(--accent); padding-left: 18px; margin-top: 1.6em;
  }

  .value { border-top: 1px solid var(--line); padding-top: 24px; }

  .certs { display: flex; flex-wrap: wrap; justify-content: center; gap: 24px; }
  .cert { flex: 0 1 300px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .cert img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .cert :global(.ph) { border-radius: 0; }
  .cert__body { padding: 20px 22px; }
  .cert__body h3 { margin: 0; }
  .cert__body p { margin: 0.4em 0 0; }
  .cert__body h3 { font-size: 1.25rem; }
  .cert__year { font-size: 0.75rem; letter-spacing: 0.18em; color: var(--accent); }

  .gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 16px; }
</style>
