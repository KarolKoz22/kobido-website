---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import IconBadge from '../components/IconBadge.astro';
import { site } from '../config/site';
import { url } from '../utils/url';

// Keyless Google Maps embed — just a search query, no API key needed.
const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(site.contact.mapQuery)}&z=15&output=embed`;
const directions = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(site.contact.mapQuery)}`;
---

<BaseLayout title="Kontakt" description={`Kontakt i dojazd — ${site.brand}, ${site.city}.`}>
  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Kontakt" title="Porozmawiajmy">
        <p>Masz pytanie o zabieg albo chcesz umówić wizytę? Zadzwoń lub napisz.</p>
      </SectionHeading>

      <div class="grid grid--2 contact">
        <div>
          <a href={`tel:${site.contact.phoneHref}`} class="contact__item">
            <IconBadge name="phone" />
            <span>
              <span class="eyebrow">Telefon</span>
              <span class="contact__big">{site.contact.phone}</span>
            </span>
          </a>
          <a href={`mailto:${site.contact.email}`} class="contact__item">
            <IconBadge name="mail" />
            <span>
              <span class="eyebrow">E-mail</span>
              <span class="contact__big">{site.contact.email}</span>
            </span>
          </a>
          <a href={directions} target="_blank" rel="noopener" class="contact__item">
            <IconBadge name="pin" />
            <span>
              <span class="eyebrow">Adres</span>
              <span class="contact__text">{site.contact.address}</span>
              <span class="contact__hint">Wyznacz trasę <Icon name="arrow-right" size={14} /></span>
            </span>
          </a>
          <div class="contact__item hover-group">
            <IconBadge name="clock" />
            <span>
              <span class="eyebrow">Godziny otwarcia</span>
              <dl class="hours">
                {site.contact.hours.map((h) => (
                  <div class="hours__row" data-days={h.days}>
                    <dt>{h.days}</dt>
                    <dd>{h.time}</dd>
                  </div>
                ))}
              </dl>
            </span>
          </div>
          <div class="btn-row">
            <a href={url('/rezerwacja')} class="btn"><Icon name="calendar" />Zarezerwuj online</a>
            <a href={site.social.instagram} target="_blank" rel="noopener" class="btn btn--ghost"><Icon name="instagram" />Instagram</a>
          </div>
        </div>

        <div class="map">
          <iframe src={mapSrc} title="Mapa dojazdu" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact { align-items: stretch; }
  .contact__item {
    display: flex;
    align-items: flex-start;
    gap: 22px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .contact__item:first-child { padding-top: 0; }
  .contact__item :global(.ib) { margin: 5px; }
  .contact__item .eyebrow { display: block; margin-bottom: 0.2rem; }
  .contact__big { display: block; font-family: var(--font-serif); font-size: 1.8rem; line-height: 1.25; word-break: break-word; transition: color 0.2s; }
  .contact__text { display: block; }
  a.contact__item:hover .contact__big { color: var(--accent); }
  .contact__hint {
    display: inline-flex; align-items: center; gap: 6px; margin-top: 4px;
    font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent);
  }
  .contact__hint :global(.icon) { transition: transform 0.25s ease; }
  a.contact__item:hover .contact__hint :global(.icon) { transform: translateX(3px); }

  .hours { display: grid; gap: 4px; margin: 0; }
  .hours__row { display: grid; grid-template-columns: auto 1fr; gap: 24px; padding: 2px 10px; margin-inline: -10px; border-radius: var(--radius); }
  .hours dd { margin: 0; color: var(--text-muted); }
  .hours__row.is-today { background: var(--accent-soft); }
  .hours__row.is-today dt::after {
    content: 'dziś'; margin-left: 8px; font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--on-accent); background: var(--btn-bg); padding: 1px 7px; border-radius: 99px; vertical-align: 2px;
  }

  .contact .btn-row { margin-top: 28px; }
  .map { min-height: 420px; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--ph-bg); }
  .map iframe { width: 100%; height: 100%; min-height: 420px; border: 0; filter: var(--map-filter); }
</style>

<script>
  // Highlight today's opening-hours row. Rows are labelled in Polish, e.g. "Poniedziałek – Piątek", "Sobota".
  const days = ['niedziela', 'poniedziałek', 'wtorek', 'środa', 'czwartek', 'piątek', 'sobota'];
  const today = new Date().getDay();
  document.querySelectorAll<HTMLElement>('.hours__row').forEach((row) => {
    const label = (row.dataset.days ?? '').toLowerCase();
    const [from, to] = label.split(/\s*[–-]\s*/).map((d) => days.indexOf(d.trim()));
    const hit = to !== undefined && to >= 0 ? from >= 0 && today >= from && today <= to : from === today;
    row.classList.toggle('is-today', hit);
  });
</script>
